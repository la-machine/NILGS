# Author: Pythagore.
#
# Settings read by compose.yml. infra/scripts/dev-setup.sh copies this file to
# .env (git-ignored); Compose loads .env automatically. Edit .env, not this file.
#
# NO SECRETS HERE. Passwords and keys are files in infra/secrets/ mounted as
# Docker secrets: environment variables leak through `docker inspect`, process
# listings and crash reports (Slice 1 design §6).
#
# Ports: the project never uses default ports (README "Ports").

# Spring profile of the app container: dev | staging | prod
SNIGF_PROFILE=dev

# Host port of the web proxy, bound to 127.0.0.1 only.
SNIGF_HTTP_PORT=47000

# Caddy site address: ":47000" locally; a domain name on staging and production.
SNIGF_SITE_ADDRESS=:47000

# Host port for the database, published only when compose.dev.yml is used.
SNIGF_DB_PORT=47432
