# SNIGF/NILGS - Copyright (c) 2026 FLYT.
# Author: Pythagore.
#
# Every tunable value of the stack (ADR-014). infra/scripts/dev-setup.sh copies
# this file to .env (git-ignored); Compose loads .env automatically and refuses
# to start if a variable is missing. Edit .env, not this file.
#
# NO SECRETS HERE. Passwords, private keys and certificates are files in
# infra/secrets/ mounted as Docker secrets: environment variables leak through
# `docker inspect`, process listings and crash reports.

# --- Runtime -----------------------------------------------------------------
# Spring profile of the app container: dev | staging | prod
SNIGF_PROFILE=dev

# --- Public endpoint (browser -> proxy, TLS 1.3 only) ----------------------------
# Host name in the browser; the proxy certificate is issued for it.
SNIGF_PUBLIC_HOSTNAME=localhost
# HTTPS port of the proxy, published on 127.0.0.1 only. No plain-HTTP port exists.
SNIGF_HTTPS_PORT=47000

# --- Internal ports (no default ports, ADR-015) ---------------------------------
SNIGF_APP_PORT=47080
# Management (health, metrics): bound to the app container's loopback only.
SNIGF_MANAGEMENT_PORT=47081
SNIGF_DB_PORT=47432
# Frontend development server and preview (HTTPS, same certificate as the proxy).
SNIGF_VITE_PORT=47173
SNIGF_VITE_PREVIEW_PORT=47174
# The proxy's listener for payment provider callbacks (mutual TLS, ADR-037), on the internal
# network provider-in only: never published on the host.
SNIGF_PROVIDER_CALLBACK_PORT=47090
# The DEMO payment simulator's charge endpoint (mutual TLS), on provider-out only.
SNIGF_PAYMENT_SIM_PORT=47091

# --- Transport security (ADR-017) ---------------------------------------------
# Certificate subject the app accepts from the proxy (mutual TLS).
SNIGF_PROXY_CLIENT_CN=snigf-web
# Header in which the proxy passes the browser's address to the app (audit records).
# The proxy overwrites any client-sent value; the app believes it only from the proxy.
SNIGF_PROXY_CLIENT_ADDRESS_HEADER=X-Snigf-Client-Address
# Header in which the proxy's provider listener passes the provider's verified certificate
# subject to the app (ADR-037). The browser listener removes it; the app believes it only from
# the proxy.
SNIGF_PROXY_PROVIDER_CLIENT_HEADER=X-Snigf-Provider-Client

# --- Development PKI (infra/scripts/dev-pki.sh) --------------------------------
SNIGF_PKI_ORGANIZATION=FLYT
SNIGF_PKI_ROOT_DAYS=3650
SNIGF_PKI_INTERMEDIATE_DAYS=730
SNIGF_PKI_LEAF_DAYS=90
# Service certificates are re-issued when they expire within this many days.
SNIGF_PKI_RENEW_BEFORE_DAYS=14

# --- Key custody: OpenBao (ADR-018) ---------------------------------------------
# API (mutual TLS 1.3) and Raft cluster ports, on key-net only.
SNIGF_BAO_PORT=47820
SNIGF_BAO_CLUSTER_PORT=47821
# trace | debug | info | warn | error. Never trace outside a debugging session:
# it logs request and response bodies.
SNIGF_BAO_LOG_LEVEL=info
# Shamir unseal: number of shares and how many are needed to unseal or to generate
# a temporary root token. In staging and production, one share per custodian.
SNIGF_BAO_UNSEAL_SHARES=5
SNIGF_BAO_UNSEAL_THRESHOLD=3
# Seconds bao-init waits for OpenBao to answer and become active.
SNIGF_BAO_INIT_TIMEOUT=120
# Mount paths of the transit engine and of the certificate login method.
SNIGF_BAO_TRANSIT_MOUNT=transit
SNIGF_BAO_AUTH_MOUNT=cert
# Login role and policy name of the application, and the certificate CN it must present.
SNIGF_BAO_APP_ROLE=snigf-app
SNIGF_BAO_APP_CLIENT_CN=snigf-app
# Transport identities of the provisioning job and of the health check (no login role).
SNIGF_BAO_ADMIN_CLIENT_CN=snigf-bao-admin
SNIGF_BAO_HEALTH_CLIENT_CN=snigf-bao-health
# Lifetime of the application's OpenBao token; it logs in again before expiry.
SNIGF_BAO_TOKEN_TTL=15m
SNIGF_BAO_TOKEN_MAX_TTL=1h
# Application-side timeouts towards OpenBao (ISO-8601 or 5s / 500ms style).
SNIGF_BAO_CONNECT_TIMEOUT=5s
SNIGF_BAO_REQUEST_TIMEOUT=10s

# --- Keys: one per purpose, never exportable or deletable (ADR-018) ---------------
SNIGF_KEY_AUDIT_CHECKPOINT=snigf-audit-checkpoint
SNIGF_KEY_RECORD_SIGNING=snigf-record-signing
# Signs the manifest of every document SNIGF issues (ADR-039); never the RECORD key.
SNIGF_KEY_DOCUMENT_ISSUANCE=snigf-document-issuance
SNIGF_KEY_DATA_ENCRYPTION=snigf-data-encryption
SNIGF_KEY_PAYMENT_CALLBACK=snigf-payment-callback
SNIGF_KEY_PASSWORD_PEPPER=snigf-password-pepper
SNIGF_KEY_BLIND_INDEX=snigf-blind-index
# Automatic rotation (hours, minimum 1h; 0 = off). Old versions keep verifying and
# decrypting. The pepper and blind index are never rotated automatically.
SNIGF_KEY_ROTATE_SIGNING=2160h
SNIGF_KEY_ROTATE_DATA_ENCRYPTION=2160h
SNIGF_KEY_ROTATE_PAYMENT_CALLBACK=8760h

# --- Authentication and sessions (ADR-004, ADR-016; Slice 1 design P5-P7) ---------
# Password policy P7: length bounds (the maximum caps hashing cost).
SNIGF_PASSWORD_MIN_LENGTH=12
SNIGF_PASSWORD_MAX_LENGTH=128
# Argon2id cost per hash (OWASP minimum: 19456 KiB, 2 passes; the app refuses less
# outside tests). Memory is used once per concurrent hash.
SNIGF_PASSWORD_ARGON2_MEMORY_KIB=19456
SNIGF_PASSWORD_ARGON2_ITERATIONS=2
SNIGF_PASSWORD_ARGON2_PARALLELISM=1
# Hashes computed at once, and how long a request waits for a slot before 503.
SNIGF_PASSWORD_MAX_CONCURRENT_HASHES=8
SNIGF_PASSWORD_HASH_QUEUE_TIMEOUT=2s
# Lockout P6: consecutive wrong passwords that lock an account, and for how long.
SNIGF_LOGIN_MAX_FAILURES=5
SNIGF_LOGIN_LOCK_DURATION=15m
# Throttling P6 per client address, and how many addresses are tracked in memory.
SNIGF_RATE_LOGIN_PER_MINUTE=20
SNIGF_RATE_REGISTER_PER_HOUR=10
SNIGF_RATE_MAX_TRACKED_CLIENTS=10000
# Session limits P5: idle and absolute.
SNIGF_SESSION_IDLE_TIMEOUT=30m
SNIGF_SESSION_ABSOLUTE_TIMEOUT=8h
# Session cookie: the __Host- prefix is required outside tests (HTTPS, path /, no Domain).
SNIGF_SESSION_COOKIE_NAME=__Host-snigf-session
# Strict | Lax. Strict: the cookie is never sent on a request started by another site.
SNIGF_SESSION_COOKIE_SAME_SITE=Strict
# Expired sessions are deleted on this schedule (Spring cron, six fields).
SNIGF_SESSION_CLEANUP_CRON=0 */5 * * * *
# CSRF token: cookie the page reads (__Host- prefix) and header it sends back.
SNIGF_CSRF_COOKIE_NAME=__Host-snigf-xsrf
SNIGF_CSRF_HEADER_NAME=X-XSRF-TOKEN

# --- Second factor: WebAuthn (ADR-016, ADR-023) ----------------------------------
# Relying-party id: the host name users see (credentials are bound to it; changing it
# invalidates every registered authenticator). Must match the host of every origin.
SNIGF_WEBAUTHN_RP_ID=localhost
# Name the authenticator shows when registering.
SNIGF_WEBAUTHN_RP_NAME=SNIGF-NILGS demo
# Exact origins allowed to run ceremonies, comma-separated, https only outside tests:
# the proxy and the Vite development server.
SNIGF_WEBAUTHN_ORIGINS=https://localhost:47000,https://localhost:47173
# How long a registration or verification may take.
SNIGF_WEBAUTHN_TIMEOUT=2m
# Attestation preference: none | indirect | direct (direct needs a device trust list).
SNIGF_WEBAUTHN_ATTESTATION=none
# Authenticators each staff member registers before enrolment completes (ADR-016: two,
# so losing one does not lock the officer out). At least 2 outside tests.
SNIGF_WEBAUTHN_MIN_AUTHENTICATORS=2
# One-time recovery codes issued at enrolment (5..20).
SNIGF_MFA_RECOVERY_CODES=10

# --- Administration (ADR-025) ------------------------------------------------------
# A role change or special grant request waits at most this long for a second
# administrator's approval; after that it can only be rejected or requested again.
SNIGF_ADMIN_REQUEST_TTL=7d

# --- Parcels (MVP-01) --------------------------------------------------------------
# Time zone whose calendar year goes into new parcel references (DEMO-PCL-...-2026-...).
SNIGF_PARCEL_REFERENCE_ZONE=Africa/Douala
# Parcels per page in a search (5..200).
SNIGF_PARCEL_PAGE_SIZE=50
# Overlap and duplicate detection (MVP-04): an overlap counts from this many square metres on
# the spheroid (0.01..1000); it is a possible duplicate when it covers at least this share of
# each parcel (0.5..1). The Baseline's demonstration thresholds; confirm with surveyors.
SNIGF_CONFLICT_MIN_OVERLAP_M2=1.00
SNIGF_CONFLICT_DUPLICATE_SHARE=0.95
# Applications (MVP-02, ADR-032): the type catalogue as a Spring resource (classpath:... built
# in, or file:/... for a file mounted into the container); a new version of a type is written
# when its definition changes. The time zone whose year goes into references (DEMO-APP-2026-...),
# applications per page (5..200), and the drafts one applicant may hold at once (1..100).
SNIGF_APPLICATION_TYPES=classpath:application-types.json
SNIGF_APPLICATION_REFERENCE_ZONE=Africa/Douala
SNIGF_APPLICATION_PAGE_SIZE=20
SNIGF_APPLICATION_MAX_DRAFTS=20
# Tracking and workload report (MVP-06, ADR-036): how long a case may stay in each state before
# the supervisor's report flags it overdue (ISO-8601 durations, above zero, at most a year).
# DEMO targets (Baseline: "for example 5 days for completeness") until the team validates them.
# Then the period the stage durations cover, back from now, and cases per page of the queue (5..200).
SNIGF_REPORTING_TARGET_COMPLETENESS_REVIEW=P5D
SNIGF_REPORTING_TARGET_INFO_REQUESTED=P30D
SNIGF_REPORTING_TARGET_UNDER_REVIEW=P10D
SNIGF_REPORTING_TARGET_PENDING_DECISION=P5D
SNIGF_REPORTING_DURATION_WINDOW=P90D
SNIGF_REPORTING_PAGE_SIZE=50

# --- Simulated payment (ADR-037) -------------------------------------------------
# NO REAL MONEY MOVES. The only provider is the DEMO simulator; any other value is refused (a real
# provider needs an ADR and a migration first). The callback key stays in OpenBao, never here.
# The DEMO fee catalogue; whether completeness acceptance waits for payment; how long a payment may
# stay pending (PT1M..P7D); how far a callback's timestamp may drift (PT10S..PT15M); the provider
# certificate names the proxy may vouch for (comma separated); when pending payments past their
# expiry are marked expired; rows per page of the finance lists (5..200).
SNIGF_PAYMENT_FEES=classpath:payment-fees.json
SNIGF_PAYMENT_REQUIRED_BEFORE_ACCEPTANCE=true
SNIGF_PAYMENT_PENDING_TTL=PT24H
SNIGF_PAYMENT_PROVIDER=DEMO_SIMULATOR
SNIGF_PAYMENT_CALLBACK_MAX_SKEW=PT5M
SNIGF_PAYMENT_PROVIDER_CLIENT_CNS=snigf-payment-sim
SNIGF_PAYMENT_EXPIRY_CRON=0 */5 * * * *
SNIGF_PAYMENT_PAGE_SIZE=50

# --- Documents issued by SNIGF (ADR-039) -----------------------------------------------------------
# DEMO acknowledgment only. The public verification page the QR code names (https; the browser's
# address of the proxy); the largest PDF accepted for verification (1 KB..5 MB); public verifications
# per minute and address (1..600); incidents per page of the officer's queue (5..200). The signing
# key is SNIGF_KEY_DOCUMENT_ISSUANCE, held in OpenBao.
SNIGF_ISSUANCE_VERIFY_BASE_URL=https://localhost:47000
SNIGF_ISSUANCE_MAX_UPLOAD_BYTES=2097152
SNIGF_RATE_VERIFY_PER_MINUTE=20
SNIGF_ISSUANCE_PAGE_SIZE=50
# The app -> simulator hop (mutual TLS): timeouts, and the app's certificate name there.
SNIGF_PAYMENT_SIMULATOR_CONNECT_TIMEOUT=PT3S
SNIGF_PAYMENT_SIMULATOR_REQUEST_TIMEOUT=PT5S
SNIGF_PAYMENT_APP_CLIENT_CN=snigf-app-payments
# The simulator: its certificate name (towards the proxy and OpenBao), its OpenBao login role
# (HMAC with the callback key, nothing else), and how long it waits before calling back.
SNIGF_PAYMENT_SIM_CLIENT_CN=snigf-payment-sim
SNIGF_BAO_PAYMENT_SIM_ROLE=snigf-payment-sim
SNIGF_PAYMENT_SIM_CALLBACK_DELAY_MS=1500
# Documents (ADR-033): where files are kept (a volume of the app only; this path is for running
# from the IDE, compose mounts its own), the largest file in bytes (Baseline: 10 MB DEMO limit),
# versions per document, the largest image in pixels (against decompression bombs), how old an
# unreferenced file must be before the cleanup removes it, and when the cleanup runs.
SNIGF_DOCUMENT_DIRECTORY=../var/documents
SNIGF_DOCUMENT_MAX_BYTES=10485760
SNIGF_DOCUMENT_MAX_VERSIONS=10
SNIGF_DOCUMENT_MAX_PIXELS=50000000
SNIGF_DOCUMENT_ORPHAN_GRACE=PT1H
SNIGF_DOCUMENT_CLEANUP_CRON=0 17 * * * *
# The largest request body the proxy forwards to the API, in bytes: a document plus its
# multipart envelope. Anything larger is refused before it reaches the application.
SNIGF_PROXY_MAX_BODY_BYTES=10600000

# --- Map views (ADR-029) --------------------------------------------------------------
# Map data (tile archives and their manifests) for a backend run from the IDE (relative to
# backend/; git-ignored). The container always reads its read-only volume map-data at /maps.
SNIGF_MAP_DATA_DIRECTORY=../var/maps
# External map providers: none is the only accepted value until one is approved (ADR-029).
SNIGF_MAP_EXTERNAL_PROVIDERS=none
# Map tools (Compose profile "maps", infra/scripts/maps-*.sh). OpenStreetMap area built for
# the geographic view (a Geofabrik area name) and its highest zoom (12..15).
SNIGF_MAPS_OSM_AREA=cameroon
SNIGF_MAPS_GEOGRAPHIC_MAXZOOM=14
# Label glyphs (Noto Sans, SIL OFL 1.1): downloaded once, refused unless the SHA-256 matches.
SNIGF_MAPS_FONTS_URL=https://github.com/openmaptiles/fonts/releases/download/v2.0/noto-sans.zip
SNIGF_MAPS_FONTS_SHA256=d117316544b43a5dde7ee761b36e17701e9f85574e181d76a74814240fdbaf34
# Folder where licensed imagery is placed for import (read-only for the tools; git-ignored).
SNIGF_MAPS_IMPORT_DIRECTORY=./var/maps-import
# Synthetic test imagery: area (west,south,east,north in degrees) and metres per pixel.
SNIGF_MAPS_SYNTHETIC_BOUNDS=11.42,3.80,11.60,3.95
SNIGF_MAPS_SYNTHETIC_RESOLUTION=4
# National satellite base (maps-build-satellite.sh): Copernicus Sentinel-2, 10 m, free and
# open. Country (ISO 3166 alpha-3, outline from Natural Earth) and margin around its border.
SNIGF_MAPS_SATELLITE_COUNTRY=CMR
SNIGF_MAPS_SATELLITE_BUFFER_KM=2
# Towns whose tiles are fetched first (name:longitude,latitude;...): useful early, the rest follows.
SNIGF_MAPS_SATELLITE_FIRST_PLACES=Yaounde:11.52,3.87;Douala:9.70,4.05;Bafoussam:10.42,5.48;Bamenda:10.15,5.96;Garoua:13.40,9.30;Maroua:14.32,10.59;Ngaoundere:13.58,7.32;Bertoua:13.68,4.58;Ebolowa:11.15,2.91;Buea:9.24,4.16;Limbe:9.21,4.02;Kribi:9.91,2.94
# Public catalogue of the Sentinel-2 archive (STAC; the European mirror is the fastest from
# here), the period searched, the cloud limit per
# scene (%), and how many scenes at most are combined per tile to fill cloud gaps.
SNIGF_MAPS_SENTINEL_STAC_URL=https://planetarycomputer.microsoft.com/api/stac/v1
# Read-only access tokens for that archive (anonymous, short-lived); empty for an open archive
# (e.g. https://earth-search.aws.element84.com/v1, slower from Central Africa).
SNIGF_MAPS_SENTINEL_TOKEN_URL=https://planetarycomputer.microsoft.com/api/sas/v1/token
SNIGF_MAPS_SENTINEL_FROM=2024-11-01
SNIGF_MAPS_SENTINEL_TO=
SNIGF_MAPS_SENTINEL_MAX_CLOUD=40
SNIGF_MAPS_SENTINEL_MAX_SCENES=4
# Optional: only these Sentinel-2 tiles (comma-separated, e.g. 32NQK for Yaounde), for a trial.
SNIGF_MAPS_SENTINEL_TILES=
# Aerial images drawn over the satellite base where they exist (OpenAerialMap ids), the
# licences accepted (';'-separated; a non-commercial licence needs legal advice first), and
# their highest zoom (20 = about 15 cm per pixel).
SNIGF_MAPS_AERIAL_CATALOGUE_URL=https://api.openaerialmap.org
SNIGF_MAPS_AERIAL_IMAGES=6a026bdea86ddaf4f4b491d8,5c645a2deaa5bc0007eea42f,5c6580f31fa6f100070431fa
SNIGF_MAPS_AERIAL_LICENCES=CC-BY 4.0
SNIGF_MAPS_AERIAL_MAX_ZOOM=20

# --- Audit trail (ADR-007, docs/audit.md) -----------------------------------------
# Signed checkpoint files, for a backend started from the IDE (relative to backend/;
# git-ignored). The container always uses its own volume (backend/Dockerfile).
SNIGF_AUDIT_CHECKPOINT_DIR=../var/audit-checkpoints
# Daily checkpoint and full verification: Spring cron, six fields
# (second minute hour day month weekday). "-" disables, which only tests may do.
SNIGF_AUDIT_CHECKPOINT_CRON=0 0 2 * * *
SNIGF_AUDIT_VERIFY_CRON=0 30 2 * * *
SNIGF_AUDIT_SCHEDULE_ZONE=Africa/Douala
# Verify the whole chain in the background each time the app starts (true | false).
SNIGF_AUDIT_VERIFY_ON_STARTUP=true
# Largest accepted "details" JSON of one event, in bytes (256..65536).
SNIGF_AUDIT_MAX_DETAILS_BYTES=8192
# Rows fetched per round trip while verifying (10..100000).
SNIGF_AUDIT_VERIFY_FETCH_SIZE=1000

# --- Database server -------------------------------------------------------------
# Log every connection and disconnection (on | off).
SNIGF_DB_LOG_CONNECTIONS=on

# --- Resource limits per container (ADR-020) ------------------------------------
SNIGF_APP_MEMORY=1g
SNIGF_APP_CPUS=2
SNIGF_APP_PIDS=512
SNIGF_DB_MEMORY=1g
SNIGF_DB_CPUS=2
SNIGF_DB_PIDS=256
SNIGF_WEB_MEMORY=256m
SNIGF_WEB_CPUS=1
SNIGF_WEB_PIDS=128
SNIGF_MIGRATE_MEMORY=512m
SNIGF_BAO_MEMORY=512m
SNIGF_BAO_CPUS=1
SNIGF_BAO_PIDS=256
SNIGF_PAYMENT_SIM_MEMORY=128m
SNIGF_PAYMENT_SIM_CPUS=0.5
SNIGF_PAYMENT_SIM_PIDS=64
# End-to-end test container (Chromium, profile "e2e", infra/scripts/e2e.sh).
SNIGF_E2E_MEMORY=2g
SNIGF_E2E_CPUS=2
SNIGF_E2E_PIDS=1024
SNIGF_E2E_SHM=512m
# Map tool jobs (profile "maps"); the Java heap is Planetiler's.
SNIGF_MAPS_MEMORY=6g
SNIGF_MAPS_CPUS=4
SNIGF_MAPS_PIDS=1024
SNIGF_MAPS_JAVA_HEAP=3g
