# Shell scripts and SQL run inside Linux containers: keep LF on every platform.
* text=auto
*.sh   text eol=lf
*.sql  text eol=lf
*.yml  text eol=lf
*Dockerfile text eol=lf
*.hcl  text eol=lf
*.template text eol=lf
*.yaml text eol=lf
# Data whose checksum is pinned (common-passwords.txt): never convert line endings.
*.txt  text eol=lf
# Extensionless scripts and configuration read inside Linux containers.
mvnw       text eol=lf
Caddyfile  text eol=lf
